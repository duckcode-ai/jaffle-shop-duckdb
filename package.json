{
  "name": "jaffle-shop-zlens",
  "private": true,
  "description": "Jaffle Shop dbt project on DuckDB with a ready-made ZLens workspace: domain model, skills, certified blocks, an App and Ask.",
  "scripts": {
    "notebook": "zlens notebook . --port 3474",
    "sync": "zlens sync dbt .",
    "compile": "zlens compile .",
    "lineage": "zlens lineage",
    "doctor": "zlens doctor .",
    "validate": "zlens validate . && zlens model validate .",
    "app:build": "zlens app build ."
  },
  "devDependencies": {
    "@zlens/cli": "^0.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
