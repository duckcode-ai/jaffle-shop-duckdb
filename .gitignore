# ZLens local runtime state. ZLens keeps its files under .dql/ and expects
# granular ignores: its local runtime (workbench, certify) drops a blanket
# `.dql/` rule and adds any of these that are missing.
dql-manifest.json
.user.yml
*.dqlnb.run.json
*.dql.run.json
*.run.json

