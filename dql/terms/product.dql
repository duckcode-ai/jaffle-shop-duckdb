// dql-format: 1

term "Product" {
  domain = "products"
  type = "entity"
  status = "certified"
  description = "A sellable food or drink item represented in the dbt products and order_items marts."
  tags = ["products", "entity"]
  owner = "analytics@jaffle.shop"
  businessOwner = "Merchandising"
  identifiers = ["product_id", "product_name"]
  synonyms = ["menu item", "item"]
  businessRules = ["Product revenue uses product_price from dev.order_items unless a block states a narrower scope."]
  caveats = ["Seeded jaffle data is local demo data, not a production product catalog."]
}
