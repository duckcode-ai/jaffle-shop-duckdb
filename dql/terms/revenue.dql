// dql-format: 1

term "Revenue" {
  domain = "revenue"
  type = "metric"
  status = "certified"
  description = "Gross jaffle shop order revenue represented in the dbt orders mart."
  tags = ["revenue", "kpi"]
  owner = "analytics@jaffle.shop"
  businessOwner = "Revenue Operations"
  synonyms = ["sales", "gross sales"]
  businessRules = ["Revenue blocks use SUM(order_total) unless the block description defines a split or aggregation grain."]
  caveats = ["Tax, refund, and discount adjustments are outside this demo model."]
}
