// dql-format: 1

term "Customer" {
  domain = "customers"
  type = "entity"
  status = "certified"
  description = "A person or account represented by one row in the dbt customers mart."
  tags = ["customers", "entity"]
  owner = "analytics@jaffle.shop"
  businessOwner = "Customer Analytics"
  identifiers = ["customer_id"]
  synonyms = ["guest", "account"]
  businessRules = ["One customer record represents the durable identity used for customer analytics."]
  caveats = ["Seeded jaffle data is local demo data, not production customer data."]
}
