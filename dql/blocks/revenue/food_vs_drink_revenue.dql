// dql-format: 1

block "food_vs_drink_revenue" {
  domain      = "revenue"
  type        = "custom"
  status      = "certified"
  owner       = "analytics@jaffle.shop"
  description = "Revenue split between food (jaffles) and drinks, from order items."
  tags        = ["revenue", "product-mix"]
  llmContext  = "Revenue by item category: classifies each row of the order_items mart as Food or Drink via is_food_item and sums product_price. Use for 'food vs drink' / product-mix revenue questions."
  examples = [{ question = "How much revenue comes from food vs drinks?" }]
  query = """
    SELECT
      CASE WHEN is_food_item THEN 'Food' ELSE 'Drink' END AS category,
      SUM(product_price) AS revenue
    FROM dev.order_items
    GROUP BY 1
    ORDER BY revenue DESC
  """
  visualization {
    chart = "bar"
    x     = "category"
    y     = "revenue"
  }
  tests {
    assert row_count >= 1
  }
}
