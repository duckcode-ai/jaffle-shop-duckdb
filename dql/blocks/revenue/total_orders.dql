// dql-format: 1

block "total_orders" {
  domain      = "revenue"
  type        = "custom"
  status      = "certified"
  datalex_contract = "revenue.Order.total_orders@1"
  owner       = "analytics@jaffle.shop"
  description = "Total number of orders placed across all locations."
  tags        = ["revenue", "kpi", "volume"]
  terms       = ["Order"]
  llmContext  = "Headline KPI: total order count = COUNT(*) over the dbt orders mart. Use for 'how many orders' / order-volume questions."
  examples = [{ question = "How many orders have we had?" }]
  query = """
    SELECT COUNT(*) AS total_orders
    FROM dev.orders
  """
  visualization {
    chart = "single_value"
  }
  tests {
    assert row_count == 1
  }
}
