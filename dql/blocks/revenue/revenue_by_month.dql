// dql-format: 1

block "revenue_by_month" {
  domain      = "revenue"
  type        = "custom"
  status      = "certified"
  datalex_contract = "revenue.Order.monthly_revenue@1"
  owner       = "analytics@jaffle.shop"
  description = "Gross revenue by calendar month, from the dbt orders mart."
  tags        = ["revenue", "kpi", "monthly"]
  terms       = ["Revenue", "Order"]

  llmContext = "Use this block for questions about revenue over time, monthly revenue, or revenue trend. Revenue is the sum of order_total from the dbt orders mart (gross, including tax). One row per calendar month."
  examples = [
    { question = "What is monthly revenue?" },
    { question = "How has revenue trended this year?" }
  ]
  invariants = ["revenue >= 0"]

  query = """
    SELECT
      date_trunc('month', ordered_at) AS month,
      SUM(order_total)                AS revenue
    FROM dev.orders
    GROUP BY 1
    ORDER BY 1
  """

  visualization {
    chart = "line"
    x     = "month"
    y     = "revenue"
  }

  tests {
    assert row_count >= 1
  }
}
