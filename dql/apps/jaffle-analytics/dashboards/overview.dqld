{
  "version": 1,
  "id": "overview",
  "metadata": {
    "title": "Jaffle Growth Command Center",
    "description": "One executive surface for certified revenue, customer value, and product-mix answers.",
    "domain": "executive",
    "visibility": "shared",
    "lifecycle": "certified",
    "tags": [
      "jaffle",
      "growth",
      "datalex",
      "certified"
    ]
  },
  "layout": {
    "kind": "grid",
    "cols": 12,
    "rowHeight": 80,
    "items": [
      {
        "i": "kpi-revenue",
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 2,
        "block": {
          "blockId": "total_revenue"
        },
        "viz": {
          "type": "single_value",
          "options": {
            "format": "currency"
          }
        },
        "title": "Total revenue"
      },
      {
        "i": "kpi-orders",
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 2,
        "block": {
          "blockId": "total_orders"
        },
        "viz": {
          "type": "single_value"
        },
        "title": "Orders"
      },
      {
        "i": "kpi-aov",
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 2,
        "block": {
          "blockId": "avg_order_value"
        },
        "viz": {
          "type": "single_value",
          "options": {
            "format": "currency"
          }
        },
        "title": "Average order value"
      },
      {
        "i": "kpi-customers",
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 2,
        "block": {
          "blockId": "total_customers"
        },
        "viz": {
          "type": "single_value"
        },
        "title": "Customers"
      },
      {
        "i": "revenue-trend",
        "x": 0,
        "y": 2,
        "w": 8,
        "h": 4,
        "block": {
          "blockId": "revenue_by_month"
        },
        "viz": {
          "type": "line",
          "options": {
            "x": "month",
            "y": "revenue",
            "format": "currency"
          }
        },
        "title": "Revenue by month"
      },
      {
        "i": "customer-mix",
        "x": 8,
        "y": 2,
        "w": 4,
        "h": 4,
        "block": {
          "blockId": "new_vs_returning_customers"
        },
        "viz": {
          "type": "bar",
          "options": {
            "x": "customer_type",
            "y": "lifetime_spend",
            "format": "currency"
          }
        },
        "title": "Customer mix by value"
      },
      {
        "i": "by-location",
        "x": 0,
        "y": 6,
        "w": 4,
        "h": 4,
        "block": {
          "blockId": "revenue_by_location"
        },
        "viz": {
          "type": "bar",
          "options": {
            "x": "location_name",
            "y": "revenue",
            "format": "currency"
          }
        },
        "title": "Revenue by location"
      },
      {
        "i": "food-drink",
        "x": 4,
        "y": 6,
        "w": 4,
        "h": 4,
        "block": {
          "blockId": "food_vs_drink_revenue"
        },
        "viz": {
          "type": "bar",
          "options": {
            "x": "category",
            "y": "revenue",
            "format": "currency"
          }
        },
        "title": "Food vs drink revenue"
      },
      {
        "i": "top-products",
        "x": 8,
        "y": 6,
        "w": 4,
        "h": 4,
        "block": {
          "blockId": "top_products"
        },
        "viz": {
          "type": "bar",
          "options": {
            "x": "product_name",
            "y": "revenue",
            "format": "currency"
          }
        },
        "title": "Top products"
      },
      {
        "i": "top-customers",
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 4,
        "block": {
          "blockId": "top_customers"
        },
        "viz": {
          "type": "table"
        },
        "title": "Top customers by lifetime spend"
      }
    ]
  }
}
